# Variables de production (ne jamais committer de vraies valeurs)
PRISME_MODE=public
PRISME_ADMIN_USER=redaction
PRISME_ADMIN_PASSWORD=
# Adresse publique si elle n'est pas fournie par l'hébergeur
PRISME_SITE_URL=
PRISME_REFRESH_MINUTES=30
PRISME_DB=/data/prisme.db
# Vérification des e-mails (Brevo) : clé API et adresse d'expéditeur validée dans Brevo
BREVO_API_KEY=
PRISME_MAIL_FROM=
